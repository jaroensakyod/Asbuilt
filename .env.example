# Copy to .env.local and fill in. Without these the app runs in demo mode.
# NEXT_PUBLIC_ASBUILT_MODE=demo keeps demo mode (no login) even when the Supabase values are set.
NEXT_PUBLIC_ASBUILT_MODE=demo

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional, only for `npm run db:migrate` (Supabase → Project Settings → Database → Connection string, session pooler)
# SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# AI provider used by every feature: gemini (default) | claude
AI_PROVIDER=gemini

# AI (Google Gemini) — create a key at https://aistudio.google.com/apikey and put it in .env.local
GEMINI_API_KEY=
# optional, default gemini-flash-latest
GEMINI_MODEL=

# AI (Anthropic Claude) — create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# needed only if the key is not tied to a workspace (Console → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
# optional, default claude-opus-5-5
CLAUDE_MODEL=
# optional: low | medium | high | xhigh | max (default medium)
CLAUDE_EFFORT=

# Baht per US dollar for the AI cost shown per call (default 33)
AI_USD_THB=
# optional JSON price overrides per model, USD per 1M tokens, e.g. {"claude-opus-5-5":{"input":4,"output":20}}
AI_PRICES=
